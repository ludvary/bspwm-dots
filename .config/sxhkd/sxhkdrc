# super = Mod4, alt = Mod1

# apps
super + Return
	ghostty

super + d
	rofi -show drun -theme ~/.config/rofi/gruvbox-bspwm.rasi

super + shift + d
	rofi -show run -theme ~/.config/rofi/gruvbox-bspwm.rasi

alt + t
	thunar

alt + d
	thunar ~/Downloads

alt + s
	thunar ~/hause/significant\ things

alt + b
	thunar ~/hause/significant\ things/books

alt + e
	cd ~/hause/significant\ things/ && emacs

alt + shift + w
	/home/Fornax/scripts/rofi-wifi-menu.sh

# eww bars and widget
super + b
	~/.config/eww/toggle.sh bottombar

super + v
	~/.config/eww/toggle.sh sidebar

super + shift + m
	~/.config/eww/toggle.sh sysmon

# notifications
super + n
	dunstctl close-all

super + shift + n
	dunstctl history-pop

# audio / brightness
XF86AudioRaiseVolume
	~/.config/i3/scripts/volume_up.sh

XF86AudioLowerVolume
	~/.config/i3/scripts/volume_down.sh

XF86AudioMute
	~/.config/i3/scripts/volume_mute.sh

XF86AudioMicMute
	pactl set-source-mute @DEFAULT_SOURCE@ toggle

alt + equal
	~/.config/i3/scripts/volume_up.sh

alt + minus
	~/.config/i3/scripts/volume_down.sh

alt + bracketright
	~/.config/i3/scripts/brightness_up.sh

alt + bracketleft
	~/.config/i3/scripts/brightness_down.sh

# ======================= screenshots / lock / misc =======================
@alt + ctrl + f
	flameshot full -p ~/scrot

@alt + ctrl + s
	flameshot gui -p ~/scrot --clipboard

alt + ctrl + Return
	$HOME/.config/eww/scripts/i3lock-widgets

@alt + ctrl + x
	xkill

# toggle the compositor
alt + p
	pkill -x picom || picom --config ~/.config/picom/picom_bspwm.conf

# reload eww after editing bars
alt + shift + p
	eww reload

# wm control
super + shift + c
	pkill -USR1 -x sxhkd && notify-send "sxhkd" "keybinds reloaded"

super + shift + r
	bspc wm -r

super + shift + e
	i3-nagbar -t warning -m 'Exit bspwm? This ends your X session.' -B 'Yes, exit' 'bspc quit'

super + q
	bspc node -c

# focus / move
super + {h,j,k,l}
	bspc node -f {west,south,north,east}

super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}

super + space
	if bspc query -N -n focused.floating >/dev/null; then bspc node -f next.tiled.local; else bspc node -f next.floating.local; fi

alt + ctrl + Tab
	bspc node -f next.local.window

# split / layout
super + shift + {b,v}
	bspc node -p {east,south}

super + ctrl + space
	bspc node -p cancel

super + f
	bspc node -t ~fullscreen

super + shift + space
	bspc node -t ~floating

super + w
	bspc desktop -l next

super + e
	bspc node @parent -R 90

super + s
	bspc node @/ -B

# workspaces
super + {1-9,0}
	~/.config/bspwm/scripts/ws-switch '^{1-9,10}'

super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

alt + Tab
	~/.config/bspwm/scripts/ws-switch last

super + ctrl + {Left,Right}
	~/.config/bspwm/scripts/ws-switch {prev,next}.local

# super+r, then h/j/k/l repeatedly; Escape leaves
super + r : {h,j,k,l}
	{bspc node -z right -20 0 || bspc node -z left 20 0, \
	 bspc node -z bottom 0 20 || bspc node -z top 0 -20, \
	 bspc node -z bottom 0 -20 || bspc node -z top 0 20, \
	 bspc node -z right 20 0 || bspc node -z left -20 0}
