# Window
window-theme = ghostty
window-decoration = none
font-family = "Martian Mono"
font-size = 12.5
adjust-cell-height = 30%

# Mouse
mouse-hide-while-typing = true

# Linux
gtk-titlebar = false
gtk-wide-tabs = false

#keybinds
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up

keybind = ctrl+shift+super+l=resize_split:right,10
keybind = ctrl+shift+super+h=resize_split:right,10
keybind = ctrl+shift+super+j=resize_split:down,10
keybind = ctrl+shift+super+k=resize_split:up,10

window-save-state = always
