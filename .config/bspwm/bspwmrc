#!/bin/sh

run() { pgrep -f "$*" >/dev/null || "$@" & }

# sxhkd
pgrep -x sxhkd >/dev/null || SXHKD_SHELL=sh sxhkd &

# workspaces
bspc monitor -d 1 2 3 4 5 6 7 8 9 0

bspc config border_width          3
bspc config window_gap            12 # same gap on every edge
bspc config top_padding           0
bspc config bottom_padding        0
bspc config right_padding         0
# left padding follows the eww rail (toggle.sh changes it live)
if eww active-windows 2>/dev/null | grep -q '^sidebar:'; then
    bspc config left_padding 60
else
    bspc config left_padding 0
fi

# gruvbox
bspc config normal_border_color   "#32302f"
bspc config active_border_color   "#504945"
bspc config focused_border_color  "#89b482"
bspc config presel_feedback_color "#d8a657"

bspc config split_ratio            0.50
bspc config borderless_monocle     true
bspc config gapless_monocle        false
bspc config focus_follows_pointer  true
bspc config pointer_follows_focus  false
bspc config automatic_scheme       longest_side
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true

# super + left-drag = move, super + right-drag = resize
bspc config pointer_modifier mod4
bspc config pointer_action1  move
bspc config pointer_action2  resize_side
bspc config pointer_action3  resize_corner

# window rules
bspc rule -r "*"
bspc rule -a gnuplot_qt state=floating focus=on
bspc rule -a Grace      state=floating
bspc rule -a Eww        state=floating sticky=on focus=off border=off

# autostarts
xsetroot -cursor_name left_ptr &
xinput set-prop "ATK NK mouse NANO dongle Mouse" "libinput Accel Profile Enabled" 0,1,0 &
xset s off
xset -dpms
xset s noblank

dex --autostart --environment bspwm &
/usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11,ssh >/dev/null 2>&1 &

# i3 configs polybar isn't used here; make sure it isn't reserving space at the top
pkill -x polybar 2>/dev/null

# feh --no-fehbg --bg-fill "$HOME/.config/bspwm/wallpaper.png" &
feh --no-fehbg --bg-fill "$HOME/hause/significant things/wallpapers/gruvbox-wallpapers/wallpapers/irl/street.jpg" &
run picom --config "$HOME/.config/picom/picom_bspwm.conf"
run dunst -config "$HOME/.config/dunst/dunstrc_bspwm"
run xfce4-power-manager
run eww daemon

pgrep -f rail-autohide >/dev/null || ~/.config/bspwm/scripts/rail-autohide &

# lock after 20 min idle
pkill xautolock
xautolock -time 20 -locker "$HOME/.config/eww/scripts/i3lock-widgets" &
