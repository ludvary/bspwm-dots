 /* wallust template - colors-rofi */

* {
active-background: #8B503D;
active-foreground: #EBF1C7;
normal-background: #1F1B1B;
normal-foreground: #EBF1C7;
urgent-background: #99B4C2;
urgent-foreground: #EBF1C7;

alternate-active-background: #4C5A6A;
alternate-active-foreground: #EBF1C7;
alternate-normal-background: #1F1B1B;
alternate-normal-foreground: #EBF1C7;
alternate-urgent-background: #1F1B1B;
alternate-urgent-foreground: #EBF1C7;

selected-active-background: #99B4C2;
selected-active-foreground: #EBF1C7;
selected-normal-background: #99B4C2;
selected-normal-foreground: #EBF1C7;
